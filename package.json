{
  "name": "lol-item-advisor",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "main": "dist-electron/main/index.js",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "desktop:build:main": "node scripts/build-electron.mjs",
    "desktop:build:renderer": "vite build -c vite.electron.config.ts",
    "desktop:build": "npm run desktop:build:main && npm run desktop:build:renderer",
    "desktop:start": "electron .",
    "desktop": "npm run desktop:build && npm run desktop:start",
    "desktop:dev": "node scripts/dev-electron.mjs",
    "typecheck:electron": "tsc -p tsconfig.electron.json"
  },
  "dependencies": {
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.11",
    "@types/node": "^22.10.0",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.6.0",
    "electron": "^33.0.0",
    "esbuild": "^0.24.0",
    "tailwindcss": "^4.1.11",
    "typescript": "^5.8.3",
    "vite": "^7.0.0"
  }
}
